#!/usr/bin/env bash
# Build dashboard locally and push to orphan branch (default gh-pages).
#
# Usage:  ./scripts/publish_dashboard.sh [--branch gh-pages] [--remote origin]
#
# Why local: AGENT/, results/ are gitignored — CI runner cannot reproduce.
# Builder must run where working tree has these directories populated.
#
# Auto-stashes any dirty WIP and restores after publish.

set -euo pipefail

# Auto-load python/3.10 if available (lmod environments) and current python is < 3.10.
if command -v module >/dev/null 2>&1 || [[ -r /etc/profile.d/lmod.sh ]]; then
  PY_MAJMIN=$(python -c 'import sys;print(f"{sys.version_info[0]}.{sys.version_info[1]}")' 2>/dev/null || echo "0.0")
  if [[ "$PY_MAJMIN" < "3.10" ]]; then
    # shellcheck disable=SC1091
    source /etc/profile.d/lmod.sh 2>/dev/null || true
    module load python/3.10 2>/dev/null && echo "[env] loaded module python/3.10" || true
  fi
fi

BRANCH="gh-pages"
REMOTE="origin"
SITE_DIR="site"
BUILD_CMD="cveval dashboard build"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --branch) BRANCH="$2"; shift 2 ;;
    --remote) REMOTE="$2"; shift 2 ;;
    --site-dir) SITE_DIR="$2"; shift 2 ;;
    --use-module) BUILD_CMD="python -m cveval.cli dashboard build"; shift ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
done

if ! command -v cveval >/dev/null 2>&1 && [[ "$BUILD_CMD" == "cveval dashboard build" ]]; then
  echo "[info] cveval CLI not found; using 'python -m cveval.cli'"
  BUILD_CMD="python -m cveval.cli dashboard build"
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
STASH_REF=""

cleanup() {
  if [[ -n "$STASH_REF" ]]; then
    echo "[cleanup] Restoring stashed WIP"
    git stash pop "$STASH_REF" >/dev/null 2>&1 || \
      echo "[warn] Could not auto-restore stash; run 'git stash list' to recover."
  fi
}
trap cleanup EXIT

if [[ -n $(git status --porcelain) ]]; then
  echo "[1/5] Stashing dirty WIP"
  git stash push -u -m "publish_dashboard auto-stash $(date -u +%s)" >/dev/null
  STASH_REF="stash@{0}"
fi

echo "[2/5] Building dashboard → $SITE_DIR/"
rm -rf "$SITE_DIR"
$BUILD_CMD --out "$SITE_DIR"

TMP=$(mktemp -d)
cp -r "$SITE_DIR"/. "$TMP/"
touch "$TMP/.nojekyll"

echo "[3/5] Switching to $BRANCH (orphan if new)"
git fetch "$REMOTE" "$BRANCH" 2>/dev/null || true
if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  git checkout "$BRANCH"
elif git show-ref --verify --quiet "refs/remotes/$REMOTE/$BRANCH"; then
  git checkout -b "$BRANCH" "$REMOTE/$BRANCH"
else
  git checkout --orphan "$BRANCH"
fi

git rm -rf . >/dev/null 2>&1 || true
cp -r "$TMP"/. .
rm -rf "$TMP"

git add -A
if git diff --cached --quiet; then
  echo "[4/5] No changes to commit"
else
  git commit -m "dashboard: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "[5/5] Pushing $BRANCH → $REMOTE"
  git push "$REMOTE" "$BRANCH"
fi

echo "[restore] Returning to $CURRENT_BRANCH"
git checkout "$CURRENT_BRANCH"

echo "Done. Configure GitHub Pages: Settings → Pages → Branch: $BRANCH / (root)."
